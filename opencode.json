{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "watcher": {
    "ignore": [
      ".git/**",
      ".direnv/**",
      "build/**",
      "target/**"
    ]
  },
  "mcp": {
    "serial-mcp": {
      "type": "local",
      "command": [
        "serial-mcp-dev",
        "--allowlist=/dev/ttyACM*,/dev/ttyUSB*,/dev/pts/*"
      ],
      "enabled": true
    },
    "nordic-semiconductor-docs": {
      "enabled": true
    },
    "zephyr-docs": {
      "enabled": true
    }
  }
}
