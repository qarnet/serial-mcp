#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Build the `native_sim` test firmware.
#
# Output directory: build/native_sim
# Firmware binary:  build/native_sim/firmware/zephyr/zephyr.exe
# Compile database: build/native_sim/firmware/compile_commands.json
#
# Export SERIAL_MCP_FW_BUILD_DIR to override the output directory.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=firmware/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="${SERIAL_MCP_FW_BUILD_DIR:-$(_fw_repo_dir)/build/native_sim}"

# Do not pass CMAKE_EXPORT_COMPILE_COMMANDS here. The sysbuild outer layer does
# not consume it and emits a CMake warning, while the inner Zephyr firmware
# build forces it on in cmake/modules/kernel.cmake. The compile database is
# therefore emitted on every build.
exec west build -b native_sim firmware/ -d "$BUILD_DIR" --pristine -- \
  "$@"
